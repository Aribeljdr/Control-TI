# CONFIGURACIÓN BACKEND - Sistema de Mantenimiento Preventivo IT
# Copia este archivo como .env y configura tus valores

# Puerto del servidor
PORT=5000

# Entorno de ejecución
NODE_ENV=development

# Base de datos MongoDB
# Para MongoDB local: mongodb://localhost:27017/nombre_base_datos
# Para MongoDB Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/nombre_base_datos
MONGODB_URI=mongodb://localhost:27017/GestionTI

# Secretos JWT - ¡CAMBIAR EN PRODUCCIÓN!
# Genera claves seguras con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTA_CLAVE_SECRETA_EN_PRODUCCION_MINIMO_32_CARACTERES
JWT_EXPIRE=7d

# Refresh Token
JWT_REFRESH_SECRET=CAMBIAR_ESTA_CLAVE_REFRESH_EN_PRODUCCION_MINIMO_32_CARACTERES
JWT_REFRESH_EXPIRE=30d

# CORS - Origen permitido del frontend
CORS_ORIGIN=http://localhost:3000

# Configuración de archivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Credenciales de administrador inicial (Cambiar después del primer uso)
# El script createAdmin.ts usará estas credenciales si no existe un admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@tuempresa.com
